# Copy to .env and adjust if needed. All values below are public demo values.
UI_BASE_URL=https://www.saucedemo.com
API_BASE_URL=https://restful-booker.herokuapp.com

# SauceDemo publishes these credentials on its login page.
SAUCE_PASSWORD=secret_sauce

# Restful Booker documents these default admin credentials in its API docs.
BOOKER_USERNAME=admin
BOOKER_PASSWORD=password123
